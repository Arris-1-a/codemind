{
  "name": "codemind",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Development Assistant — code review, PR analysis, code generation, documentation automation",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'packages/*/__tests__/**/*.ts'",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "cli": "pnpm --filter @codemind/cli cli"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
